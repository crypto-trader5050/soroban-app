/* =========================================================
   そろばんトレーニング
   style.css 完全統合版

   ・既存フラッシュ暗算CSSを維持
   ・新トップ画面CSSを追加
   ・JavaScriptは変更しない
========================================================= */


/* =====================================================
   フォント
===================================================== */

@font-face {
  font-family: 'Soloburn';
  src:
    url('assets/fonts/Soloburn.woff2') format('woff2'),
    url('assets/fonts/Soloburn.woff') format('woff');
  font-weight: normal;
  font-style: normal;
}


/* =====================================================
   共通設定
===================================================== */

* {
  box-sizing: border-box;
}

html {
  margin: 0;
  padding: 0;
}

button,
input {
  font-family: inherit;
}

/* =========================================================
   HOME画面
   完成デザイン版
========================================================= */

#home {
  min-height: 100vh;
  margin: 0;
  padding: 0;

  position: relative;
  overflow: hidden;

  color: #102f58;
  text-align: left;

  background:
    radial-gradient(
      circle at 3% 25%,
      rgba(93, 185, 242, 0.28) 0 38px,
      transparent 40px
    ),
    radial-gradient(
      circle at 97% 20%,
      rgba(255, 255, 255, 0.95) 0 45px,
      transparent 130px
    ),
    linear-gradient(
      180deg,
      #d9f4ff 0%,
      #eefaff 32%,
      #ffffff 70%,
      #ffffff 100%
    );
}


/* =====================================================
   HOME 背景装飾
   水しぶき・波・光
===================================================== */

#home::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  z-index: 0;

  background:
    /* 左上の斜め光 */
    repeating-linear-gradient(
      135deg,
      transparent 0 17px,
      rgba(255, 255, 255, 0.48) 18px 27px,
      transparent 28px 45px
    ) left top / 360px 220px no-repeat,

    /* 中央の水面 */
    linear-gradient(
      150deg,
      transparent 0 38%,
      rgba(97, 193, 239, 0.13) 38.5% 41%,
      transparent 41.5% 48%,
      rgba(255, 255, 255, 0.65) 48.5% 52%,
      transparent 52.5%
    ),

    /* 左下の水しぶき */
    radial-gradient(
      circle at 4% 57%,
      rgba(93, 185, 242, 0.25) 0 65px,
      transparent 67px
    ),

    radial-gradient(
      circle at 11% 43%,
      transparent 0 48px,
      rgba(255, 255, 255, 0.6) 49px 52px,
      transparent 53px
    ),

    /* 右側の波紋 */
    radial-gradient(
      circle at 94% 39%,
      transparent 0 58px,
      rgba(91, 187, 239, 0.18) 59px 63px,
      transparent 64px
    ),

    radial-gradient(
      circle at 96% 42%,
      transparent 0 85px,
      rgba(91, 187, 239, 0.12) 86px 90px,
      transparent 91px
    );
}


/* =====================================================
   小さな水滴・光
===================================================== */

#home::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  z-index: 0;

  opacity: 0.65;

  background:
    radial-gradient(
      circle,
      rgba(71, 166, 231, 0.28) 0 2px,
      transparent 3px
    ) 87% 23% / 18px 18px,

    radial-gradient(
      circle,
      rgba(71, 166, 231, 0.18) 0 2px,
      transparent 3px
    ) 91% 27% / 22px 22px,

    radial-gradient(
      circle,
      rgba(255, 255, 255, 0.85) 0 2px,
      transparent 3px
    ) 15% 25% / 35px 35px;
}


#home > * {
  position: relative;
  z-index: 1;
}


/* =====================================================
   HOME ヘッダー
===================================================== */

.home-header {
  width: 100%;
  min-height: 102px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 3.5%;

  background:
    linear-gradient(
      180deg,
      #0757a3 0%,
      #06468d 100%
    );

  color: #ffffff;

  box-shadow:
    0 2px 10px rgba(0, 48, 96, 0.15);
}


/* =====================================================
   ロゴ
===================================================== */

.logo-area {
  display: flex;
  align-items: center;
  gap: 14px;
}


.logo-icon {
  width: 58px;
  height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;

  font-size: 45px;
  line-height: 1;

  transform: rotate(-5deg);
}


.logo-text {
  margin: 0;

  color: #ffffff;

  font-size: clamp(28px, 3.2vw, 46px);

  font-weight: 900;

  letter-spacing: 1px;

  line-height: 1;
}


/* =====================================================
   ヘッダーメニュー
===================================================== */

.header-menu {
  display: flex;
  align-items: center;
  gap: 16px;
}


.header-menu-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 3px;

  min-width: 66px;

  margin: 0;
  padding: 0;

  background: transparent;

  color: #ffffff;

  border: none;

  border-radius: 0;

  font-size: 15px;
  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    opacity 0.15s ease;
}


.header-menu-button:hover {
  background: transparent;
  border-color: transparent;
  opacity: 0.9;

  transform: translateY(-2px);
}


.header-menu-button:active {
  transform: scale(0.96);
}


.header-menu-icon {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #1475d1;

  color: #ffffff;

  border-radius: 50%;

  font-size: 29px;
  font-weight: 900;

  line-height: 1;

  box-shadow:
    inset 0 1px 2px rgba(255,255,255,0.25),
    0 3px 8px rgba(0,0,0,0.12);
}


/* =====================================================
   HOME メイン
===================================================== */

.home-main {
  width: min(1240px, 92%);

  margin: 0 auto;

  padding: 25px 0 15px;
}


/* =====================================================
   HOME ヒーロー
===================================================== */

.hero-section {
  position: relative;

  min-height: 200px;

  display: flex;
  align-items: center;

  margin-bottom: 18px;

  padding: 22px 30px;

  overflow: visible;

  background: transparent;

  border: none;

  border-radius: 0;

  box-shadow: none;
}


.hero-text {
  position: relative;

  z-index: 3;

  max-width: 650px;

  padding-top: 3px;
}


.hero-text h1 {
  margin: 0 0 8px;

  color: #102f58;

  font-size: clamp(34px, 4vw, 51px);

  font-weight: 900;

  line-height: 1.25;

  letter-spacing: 1px;
}


.hero-text h1 span {
  color: #f47b19;
}


.hero-text p {
  margin: 0;

  color: #17385e;

  font-size: 20px;

  font-weight: 700;

  line-height: 1.6;
}


/* =====================================================
   ヒーロー下の点線
===================================================== */

.hero-text::after {
  content: "";

  display: block;

  width: 630px;
  max-width: 90%;

  margin-top: 12px;

  border-bottom:
    5px dotted #4ca9e9;
}


/* =====================================================
   ヒーロー キャラクター
===================================================== */

.hero-character {
  position: absolute;

  right: 12px;
  bottom: -40px;

  width: 450px;

  pointer-events: none;

  z-index: 4;
}


.hero-character-image {
  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(0 7px 7px rgba(38, 91, 126, 0.13));
}


/* =====================================================
   HOME メイン3カード
===================================================== */

.main-cards {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 42px;

  margin-bottom: 15px;
}


.main-card {
  position: relative;

  min-height: 365px;

  display: flex;
  flex-direction: column;

  padding: 20px 34px 16px;

  background: rgba(255,255,255,0.97);

  border: 2px solid;

  border-radius: 19px;

  box-shadow:
    0 4px 12px rgba(29, 76, 112, 0.06);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}


.main-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 9px 20px rgba(29, 76, 112, 0.12);
}


/* =====================================================
   カード色
===================================================== */

.flash-card {
  border-color: #1683e6;
}


.print-card {
  border-color: #17a86b;
}


.read-card {
  border-color: #ff8a00;
}


/* =====================================================
   カードアイコン
===================================================== */

.card-icon {
  width: 76px;
  height: 76px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 10px;

  border-radius: 50%;

  color: #ffffff;

  font-size: 39px;

  line-height: 1;

  box-shadow:
    0 2px 5px rgba(0,0,0,0.08);
}


.flash-icon {
  background: #1683e6;
}


.print-icon {
  background: #17a86b;
}


.read-icon {
  background: #ff8a00;
}


/* =====================================================
   カード見出し
===================================================== */

.main-card h2 {
  margin: 0 0 5px;

  text-align: center;

  font-size: 28px;

  font-weight: 900;

  line-height: 1.35;
}


.flash-card h2 {
  color: #0758a8;
}


.print-card h2 {
  color: #087d4d;
}


.read-card h2 {
  color: #ef7100;
}


/* =====================================================
   カード説明
===================================================== */

.card-lead {
  min-height: 52px;

  margin: 0 0 7px;

  text-align: center;

  color: #182c42;

  font-size: 14px;

  font-weight: 600;

  line-height: 1.65;
}


/* =====================================================
   カード点線
===================================================== */

.card-lead::after {
  content: "";

  display: block;

  margin: 8px auto 0;

  width: 100%;

  border-bottom: 3px dotted;
}


.flash-card .card-lead::after {
  border-color: #1683e6;
}


.print-card .card-lead::after {
  border-color: #17a86b;
}


.read-card .card-lead::after {
  border-color: #ff8a00;
}


/* =====================================================
   カード項目
===================================================== */

.card-features {
  display: flex;
  flex-direction: column;

  gap: 2px;

  margin: 4px 0 10px;

  padding: 0;

  list-style: none;
}


.card-features li {
  position: relative;

  padding: 0 0 0 25px;

  background: transparent;

  color: #24384c;

  border-radius: 0;

  font-size: 14px;

  font-weight: 700;

  line-height: 1.55;
}


.card-features li::before {
  content: "✓";

  position: absolute;

  left: 0;
  top: 50%;

  width: 18px;
  height: 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  transform: translateY(-50%);

  border-radius: 50%;

  color: #ffffff;

  font-size: 12px;
  font-weight: 900;
}


.flash-card .card-features li::before {
  background: #1683e6;
}


.print-card .card-features li::before {
  background: #17a86b;
}


.read-card .card-features li::before {
  background: #ff8a00;
}


/* =====================================================
   カードボタン
===================================================== */

.main-card-button {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;

  margin: auto 0 0;

  padding: 11px 18px;

  color: #ffffff;

  border: none;

  border-radius: 28px;

  font-size: 22px;

  font-weight: 900;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    opacity 0.15s ease;
}


.main-card-button:hover {
  opacity: 0.92;

  transform: translateY(-1px);
}


.main-card-button:active {
  transform: scale(0.98);
}


.flash-card .main-card-button {
  background: #1683e6;
}


.print-card .main-card-button {
  background: #17a86b;
}


.read-card .main-card-button {
  background: #ff8a00;
}


.arrow {
  position: absolute;

  right: 22px;

  font-size: 36px;

  line-height: 0.8;
}


/* =====================================================
   HOME 4つの特徴
===================================================== */

.feature-bar {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  margin-bottom: 14px;

  overflow: hidden;

  background: rgba(255,255,255,0.97);

  border: 2px solid #d5dde4;

  border-radius: 17px;

  box-shadow:
    0 3px 10px rgba(35, 74, 105, 0.05);
}


.feature-item {
  min-height: 112px;

  display: flex;
  align-items: center;

  gap: 13px;

  padding: 15px 18px;

  border-right: 1px solid #dfe5ea;
}


.feature-item:last-child {
  border-right: none;
}


.feature-icon {
  width: 60px;
  height: 60px;

  flex: 0 0 60px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;

  border-radius: 0;

  font-size: 43px;

  line-height: 1;
}


.feature-item h3 {
  margin: 0 0 4px;

  color: #123e72;

  font-size: 17px;

  font-weight: 900;

  line-height: 1.35;
}


.feature-item p {
  margin: 0;

  color: #233a53;

  font-size: 12px;

  font-weight: 600;

  line-height: 1.55;
}


/* =====================================================
   HOME 下部パネル
===================================================== */

.bottom-panels {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 24px;

  margin-bottom: 13px;
}


.bottom-panel {
  position: relative;

  min-height: 190px;

  padding: 16px 28px;

  background: #ffffff;

  border: 2px solid;

  border-radius: 17px;

  overflow: hidden;

  box-shadow:
    0 3px 10px rgba(35, 74, 105, 0.04);
}


.message-panel {
  background:
    linear-gradient(
      135deg,
      #eef8ff 0%,
      #ffffff 100%
    );

  border-color: #a7d5f5;
}


.recommend-panel {
  background:
    linear-gradient(
      135deg,
      #fffdf4 0%,
      #fff8e4 100%
    );

  border-color: #f2d28b;
}


/* =====================================================
   パネルタイトル
===================================================== */

.panel-title {
  display: flex;
  align-items: center;

  gap: 10px;

  margin-bottom: 5px;
}


.panel-title-icon {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;

  border-radius: 0;

  font-size: 27px;

  line-height: 1;
}


.panel-title h2 {
  margin: 0;

  color: #123e72;

  font-size: 22px;

  font-weight: 900;
}


/* =====================================================
   今日のひとこと
===================================================== */

.message-content {
  position: relative;

  z-index: 2;

  padding-left: 47px;
}


.message-content p {
  margin: 2px 0;

  color: #17283c;

  font-size: 17px;

  font-weight: 700;

  line-height: 1.45;
}


.message-content p:first-child {
  margin-top: 4px;

  color: #152d4d;

  font-family:
    "Soloburn",
    sans-serif;

  font-size: 25px;

  font-weight: 800;
}


/* =====================================================
   下部キャラクター
===================================================== */

.small-character {
  position: absolute;

  right: 22px;
  bottom: 45px;

  font-size: 85px;

  line-height: 1;

  z-index: 1;
}


/* =====================================================
   おすすめの使い方
===================================================== */

.recommend-list {
  margin: 0 0 5px;

  padding-left: 28px;

  color: #182d46;

  font-size: 15px;

  font-weight: 700;

  line-height: 1.7;
}


.recommend-list li {
  padding-left: 4px;
}


.recommend-list strong {
  color: #123e72;
}


.recommend-message {
  margin: 0;

  color: #ef7210;

  font-size: 16px;

  font-weight: 900;

  line-height: 1.5;
}


/* =====================================================
   HOME フッター
===================================================== */

.home-footer {
  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: flex-start;

  gap: 40px;

  padding: 7px 5.5%;

  background:
    linear-gradient(
      180deg,
      #0758a4 0%,
      #06488f 100%
    );

  color: #ffffff;
}


.footer-logo {
  display: flex;
  align-items: center;

  gap: 8px;

  font-size: 21px;

  font-weight: 900;
}


.footer-logo span {
  letter-spacing: 0.5px;
}


.footer-description {
  font-size: 14px;

  font-weight: 600;

  opacity: 0.95;
}


/* =====================================================
   =====================================================
   ここから下は既存機能
   元のCSSを維持
   =====================================================
   ===================================================== */


/* =====================================================
   全体（フラッシュ仕様）
===================================================== */

body {
  margin: 0;
  padding: 20px;
  text-align: center;

  background-color: black;
  color: #00ff00;

  font-family: sans-serif;
}


/* =====================================================
   HOME表示中だけbodyをHOME用にする
===================================================== */

body:has(#home:not([style*="display: none"])) {
  background:
    linear-gradient(
      180deg,
      #f4fbff 0%,
      #ffffff 45%,
      #f4f9fc 100%
    );

  color: #294257;

  padding: 0;

  text-align: left;
}


/* =====================================================
   数字フォント統一
===================================================== */

#display,
#printArea,
#answerInput {
  font-family: "Soloburn", monospace;
}


/* =====================================================
   フラッシュ表示（メイン）
===================================================== */

#display {
  position: absolute;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -50%);

  font-family: "Soloburn", monospace;

  color: #00ff00;

  white-space: nowrap;

  max-width: 95%;

  overflow: hidden;

  text-align: center;

  letter-spacing: 6px;

  width: 100%;

  display: flex;

  justify-content: center;
  align-items: center;

  pointer-events: none;
}


/* =====================================================
   入力欄
===================================================== */

#answerInput {
  font-size: 36px;

  width: 480px;

  max-width: 90%;

  padding: 15px;

  text-align: right;

  margin-bottom: 15px;

  background: black;

  color: #00ff00;

  border: 2px solid #00ff00;

  border-radius: 10px;

  box-shadow:
    0 0 10px #00ff00;
}


#keypad {
  display: grid;

  grid-template-columns:
    repeat(3, 80px);

  gap: 12px;

  justify-content: center;

  position: relative;

  z-index: 10;
}


#keypad button {
  font-size: 24px;

  padding: 18px;

  border-radius: 10px;

  background: black;

  color: #00ff00;

  border: 1px solid #00ff00;

  transition: 0.1s;

  position: relative;

  z-index: 11;
}


/* ホバー */

#keypad button:hover {
  background: #002200;
}


/* 押したとき */

#keypad button:active {
  transform: scale(0.95);

  background: #003300;

  box-shadow:
    0 0 8px #00ff00 inset;
}


/* =====================================================
   判定表示
===================================================== */

#judge {
  margin-top: 20px;

  font-size: 22px;
}


/* =====================================================
   ボタン
===================================================== */

button {
  font-size: 16px;

  padding: 10px 15px;

  margin: 5px;

  background: black;

  color: #00ff00;

  border: 1px solid #00ff00;

  cursor: pointer;
}


button:hover {
  background: #003300;
}


/* =====================================================
   印刷エリア
===================================================== */

#printArea {
  font-size: 20px;

  line-height: 1.6;

  margin-top: 20px;
}


/* =====================================================
   不要な文字を消す用
===================================================== */

.hidden {
  display: none;
}


/* =====================================================
   題目表示
===================================================== */

#questionTitle {
  font-size: 36px;

  color: #00ff00;

  margin-top: 100px;
}


/* =====================================================
   級表示
===================================================== */

#levelInfo {
  font-size: 22px;

  color: #00ff00;

  margin-bottom: 20px;
}


/* =====================================================
   問題情報
===================================================== */

#questionInfo {
  color: #00ff00;

  font-size: 18px;
}


/* =====================================================
   フラッシュ暗算 種目選択画面
   HOMEと完全に同じ背景世界観
===================================================== */

#flashSelect {
  min-height: 100vh;

  margin: -20px;
  padding: 55px 20px 45px;

  position: relative;
  overflow: hidden;

  color: #102f58;
  text-align: center;

  background:
    radial-gradient(
      circle at 3% 25%,
      rgba(93, 185, 242, 0.28) 0 38px,
      transparent 40px
    ),

    radial-gradient(
      circle at 97% 20%,
      rgba(255, 255, 255, 0.95) 0 45px,
      transparent 130px
    ),

    linear-gradient(
      180deg,
      #d9f4ff 0%,
      #eefaff 32%,
      #ffffff 70%,
      #ffffff 100%
    );
}


/* =====================================================
   フラッシュ暗算背景装飾
   HOMEと同じ水しぶき・波・光
===================================================== */

#flashSelect::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  z-index: 0;

  background:
    repeating-linear-gradient(
      135deg,
      transparent 0 17px,
      rgba(255, 255, 255, 0.48) 18px 27px,
      transparent 28px 45px
    ) left top / 360px 220px no-repeat,

    linear-gradient(
      150deg,
      transparent 0 38%,
      rgba(97, 193, 239, 0.13) 38.5% 41%,
      transparent 41.5% 48%,
      rgba(255, 255, 255, 0.65) 48.5% 52%,
      transparent 52.5%
    ),

    radial-gradient(
      circle at 4% 57%,
      rgba(93, 185, 242, 0.25) 0 65px,
      transparent 67px
    ),

    radial-gradient(
      circle at 11% 43%,
      transparent 0 48px,
      rgba(255, 255, 255, 0.6) 49px 52px,
      transparent 53px
    ),

    radial-gradient(
      circle at 94% 39%,
      transparent 0 58px,
      rgba(91, 187, 239, 0.18) 59px 63px,
      transparent 64px
    ),

    radial-gradient(
      circle at 96% 42%,
      transparent 0 85px,
      rgba(91, 187, 239, 0.12) 86px 90px,
      transparent 91px
    );
}


/* =====================================================
   小さな水滴・光
===================================================== */

#flashSelect::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  z-index: 0;

  opacity: 0.65;

  background:
    radial-gradient(
      circle,
      rgba(71, 166, 231, 0.28) 0 2px,
      transparent 3px
    ) 87% 23% / 18px 18px,

    radial-gradient(
      circle,
      rgba(71, 166, 231, 0.18) 0 2px,
      transparent 3px
    ) 91% 27% / 22px 22px,

    radial-gradient(
      circle,
      rgba(255, 255, 255, 0.85) 0 2px,
      transparent 3px
    ) 15% 25% / 35px 35px;
}


/* =====================================================
   フラッシュ暗算の中身を前面へ
===================================================== */

#flashSelect > * {
  position: relative;
  z-index: 1;
}


/* =====================================================
   フラッシュ暗算 タイトル
===================================================== */

#typeSelect .flash-select-inner {

  width: min(1100px, 94%);

  margin: 0 auto;

}


/* =====================================================
   タイトル部分
===================================================== */

#typeSelect .flash-select-header {

  margin-bottom: 42px;

}


/* =====================================================
   ⚡ アイコン
===================================================== */

#typeSelect .flash-select-icon {

  width: 76px;

  height: 76px;

  margin: 0 auto 18px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #1683e6;

  color: #ffffff;

  border-radius: 22px;

  font-size: 40px;

  line-height: 1;

  box-shadow:
    0 5px 15px rgba(22, 131, 230, 0.20);
}


/* =====================================================
   タイトル
===================================================== */

#typeSelect .flash-select-header h1 {

  margin: 0 0 12px;

  color: #102f58;

  font-size: clamp(32px, 4vw, 46px);

  font-weight: 900;

  line-height: 1.3;

  letter-spacing: 1px;

}


/* =====================================================
   説明
===================================================== */

#typeSelect .flash-select-header p {

  margin: 0;

  color: #385875;

  font-size: 17px;

  font-weight: 600;

  line-height: 1.8;

}


/* =====================================================
   3つの種目カード
===================================================== */

#typeSelect .flash-type-cards {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 30px;

  margin-bottom: 35px;

}


/* =====================================================
   種目カード共通
===================================================== */

#typeSelect .flash-type-card {

  min-height: 335px;

  display: flex;

  flex-direction: column;

  align-items: center;

  padding: 28px 30px 25px;

  background: rgba(255,255,255,0.97);

  border: 2px solid;

  border-radius: 19px;

  box-shadow:
    0 4px 12px rgba(29, 76, 112, 0.07);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;

}


/* =====================================================
   カード ホバー
===================================================== */

#typeSelect .flash-type-card:hover {

  transform: translateY(-4px);

  box-shadow:
    0 10px 22px rgba(29, 76, 112, 0.13);

}


/* =====================================================
   カード色
===================================================== */

#typeSelect .mitori-type-card {

  border-color: #1683e6;

}


#typeSelect .kake-type-card {

  border-color: #17a86b;

}


#typeSelect .wari-type-card {

  border-color: #ff8a00;

}


/* =====================================================
   種目アイコン
===================================================== */

#typeSelect .flash-type-icon {

  width: 78px;

  height: 78px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 18px;

  border-radius: 50%;

  font-size: 39px;

  font-weight: 900;

  line-height: 1;

  box-shadow:
    0 2px 5px rgba(0,0,0,0.08);

}


/* 見取り */

#typeSelect .mitori-type-card .flash-type-icon {

  background: #1683e6;

  color: #ffffff;

}


/* 乗算 */

#typeSelect .kake-type-card .flash-type-icon {

  background: #17a86b;

  color: #ffffff;

}


/* 除算 */

#typeSelect .wari-type-card .flash-type-icon {

  background: #ff8a00;

  color: #ffffff;

}


/* =====================================================
   種目タイトル
===================================================== */

#typeSelect .flash-type-card h2 {

  margin: 0 0 9px;

  color: #102f58;

  font-size: 27px;

  font-weight: 900;

  line-height: 1.35;

}


/* =====================================================
   種目説明
===================================================== */

#typeSelect .flash-type-card p {

  margin: 0 0 25px;

  color: #38536c;

  font-size: 14px;

  font-weight: 600;

  line-height: 1.6;

}


/* =====================================================
   はじめるボタン
===================================================== */

#typeSelect .flash-type-button {

  width: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  position: relative;

  margin: auto 0 0;

  padding: 11px 18px;

  color: #ffffff;

  border: none;

  border-radius: 28px;

  font-size: 20px;

  font-weight: 900;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    opacity 0.15s ease;

}


/* ボタン色 */

#typeSelect .mitori-type-card .flash-type-button {

  background: #1683e6;

}


#typeSelect .kake-type-card .flash-type-button {

  background: #17a86b;

}


#typeSelect .wari-type-card .flash-type-button {

  background: #ff8a00;

}


/* =====================================================
   ボタン ホバー
===================================================== */

#typeSelect .flash-type-button:hover {

  opacity: 0.90;

  transform: translateY(-1px);

}


#typeSelect .flash-type-button:active {

  transform: scale(0.98);

}


/* =====================================================
   ボタン矢印
===================================================== */

#typeSelect .flash-type-button .arrow {

  position: absolute;

  right: 22px;

  font-size: 34px;

  line-height: 0.8;

}


/* =====================================================
   ホームへ戻る
===================================================== */

#typeSelect .flash-home-button {

  background: transparent !important;

  color: #496b82 !important;

  border: none !important;

  font-size: 15px !important;

  font-weight: 700;

  cursor: pointer;

}


#typeSelect .flash-home-button:hover {

  background: transparent !important;

  color: #1683e6 !important;

}


/* =====================================================
   レベル選択
===================================================== */

#levelSelect {
  min-height: 100vh;

  margin: 0;
  padding: 50px 20px;

  text-align: center;

  background: black;

  color: #00ff00;
}


#levelSelect h2 {
  color: #00ff00;

  margin-bottom: 30px;
}


#levelSelect button {
  background: black;

  color: #00ff00;

  border: 1px solid #00ff00;

  border-radius: 6px;

  cursor: pointer;
}


#levelSelect button:hover {
  background: #003300;
}


/* =====================================================
   実行画面
===================================================== */

#app {
  min-height: 100vh;

  margin: -20px;

  padding: 20px;

  text-align: center;

  background: black;

  color: #00ff00;
}


/* =====================================================
   実行画面のボタン
===================================================== */

#app > button {
  font-size: 16px;

  padding: 10px 15px;

  margin: 5px;

  background: black;

  color: #00ff00;

  border: 1px solid #00ff00;

  cursor: pointer;
}


#app > button:hover {
  background: #003300;
}


/* =====================================================
   =====================================================
   スマートフォン
   =====================================================
   ===================================================== */

@media (max-width: 900px) {

  /* HOME */

  .home-header {
    padding: 0 4%;
  }


  .home-main {
    width: 94%;

    padding-top: 25px;
  }


  .hero-section {
    padding: 35px;

    min-height: 230px;
  }


  .hero-character {
    right: 15px;

    transform: scale(0.8);

    transform-origin: bottom right;

    opacity: 0.75;
  }


  .main-cards {
    grid-template-columns: 1fr;
  }


  .main-card {
    min-height: auto;
  }


  .feature-bar {
    grid-template-columns:
      repeat(2, 1fr);
  }


  .feature-item:nth-child(2) {
    border-right: none;
  }


  .feature-item:nth-child(-n + 2) {
    border-bottom: 1px solid #e6edf2;
  }


  .bottom-panels {
    grid-template-columns: 1fr;
  }

}


/* =====================================================
   スマートフォン小型
===================================================== */

@media (max-width: 600px) {

  /* HOME */

  .home-header {
    min-height: 72px;

    padding: 12px 4%;
  }


  .logo-text {
    font-size: 16px;
    white-space: nowrap;
  }


  .logo-icon {
    width: 39px;
    height: 39px;

    font-size: 22px;
  }


  .header-menu {
    gap: 3px;
  }


  .header-menu-button {
    padding: 7px 9px;

    font-size: 12px;
  }


  .header-menu-icon {
    font-size: 14px;
  }


  .hero-section {
    min-height: 260px;

    padding: 28px 23px;
  }


  .hero-text h1 {
    font-size: 29px;
  }


  .hero-text p {
    font-size: 13px;
  }


  .hero-character {
    right: -45px;

    bottom: -45px;

    transform: scale(0.50);

    opacity: 0.55;
  }


  .main-card {
    padding: 25px;
  }


  .feature-bar {
    grid-template-columns: 1fr;
  }


  .feature-item {
    border-right: none;

    border-bottom: 1px solid #e6edf2;
  }


  .feature-item:last-child {
    border-bottom: none;
  }


  .bottom-panel {
    padding: 23px;
  }


  .home-footer {
    flex-direction: column;

    gap: 8px;

    text-align: center;
  }


  /* フラッシュ暗算 */

  #answerInput {
    width: 90%;
  }


  #keypad {
    grid-template-columns:
      repeat(3, 70px);
  }


  #keypad button {
    padding: 15px;

    font-size: 21px;
  }

}

/* =====================================================
   フラッシュ暗算 メニュー画面
   トップ画面と同じ水色系の世界観
===================================================== */

#flashSelect {
  min-height: 100vh;

  margin: -20px;

  padding: 55px 20px 45px;

  background:
    radial-gradient(
      circle at 10% 15%,
      rgba(255, 255, 255, 0.90) 0,
      rgba(255, 255, 255, 0.35) 70px,
      transparent 150px
    ),

    radial-gradient(
      circle at 90% 20%,
      rgba(255, 255, 255, 0.80) 0,
      rgba(255, 255, 255, 0.30) 70px,
      transparent 150px
    ),

    radial-gradient(
      circle at 15% 80%,
      rgba(117, 211, 246, 0.20) 0,
      transparent 180px
    ),

    radial-gradient(
      circle at 85% 75%,
      rgba(101, 204, 242, 0.18) 0,
      transparent 190px
    ),

    linear-gradient(
      180deg,
      #d9f5ff 0%,
      #e9f9ff 38%,
      #f8fdff 75%,
      #ffffff 100%
    );

  color: #294257;

  text-align: center;
}


/* =====================================================
   フラッシュ暗算 メイン
===================================================== */

.flash-select-inner {
  width: min(1100px, 94%);

  margin: 0 auto;
}


/* =====================================================
   タイトル部分
===================================================== */

.flash-select-header {
  margin-bottom: 42px;
}


.flash-select-icon {
  width: 70px;
  height: 70px;

  margin: 0 auto 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: #fff0d7;

  font-size: 36px;

  box-shadow:
    0 5px 18px rgba(41, 76, 105, 0.08);
}


.flash-select-header h1 {
  margin: 0 0 12px;

  color: #294458;

  font-size: clamp(30px, 4vw, 43px);

  font-weight: 800;

  line-height: 1.35;
}


.flash-select-header p {
  margin: 0;

  color: #667f90;

  font-size: 16px;

  line-height: 1.8;
}


/* =====================================================
   3種目カード
===================================================== */

.flash-menu-cards {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;

  margin-bottom: 35px;
}


.flash-menu-card {
  min-height: 330px;

  display: flex;
  flex-direction: column;
  align-items: center;

  padding: 32px 28px;

  background: #ffffff;

  border: 1px solid #dfe9f0;

  border-radius: 20px;

  box-shadow:
    0 6px 20px rgba(41, 76, 105, 0.07);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}


.flash-menu-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 12px 28px rgba(41, 76, 105, 0.13);
}


/* =====================================================
   種目アイコン
===================================================== */

.flash-menu-icon {
  width: 76px;
  height: 76px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 20px;

  border-radius: 20px;

  font-size: 38px;

  font-weight: 800;

  line-height: 1;
}


.mitori-menu-card .flash-menu-icon {
  background: #fff0d7;
}


.kake-menu-card .flash-menu-icon {
  background: #e6f5ff;

  color: #2998d5;
}


.wari-menu-card .flash-menu-icon {
  background: #e8f7eb;

  color: #58a96a;
}


/* =====================================================
   種目タイトル
===================================================== */

.flash-menu-card h2 {
  margin: 0 0 12px;

  color: #294255;

  font-size: 24px;

  font-weight: 800;

  line-height: 1.4;
}


.flash-menu-card p {
  margin: 0 0 28px;

  color: #6b7f8d;

  font-size: 14px;

  line-height: 1.7;
}


/* =====================================================
   はじめるボタン
===================================================== */

.flash-menu-card button {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: auto 0 0;

  padding: 13px 18px;

  color: #ffffff;

  border: none;

  border-radius: 10px;

  font-size: 15px;

  font-weight: 700;

  cursor: pointer;

  transition:
    opacity 0.2s ease,
    transform 0.1s ease;
}


.mitori-menu-card button {
  background: #efa13a;
}


.kake-menu-card button {
  background: #2998d5;
}


.wari-menu-card button {
  background: #58a96a;
}


.flash-menu-card button:hover {
  opacity: 0.88;
}


.flash-menu-card button:active {
  transform: scale(0.98);
}


/* =====================================================
   ホームへ戻る
===================================================== */

.flash-home-button {
  background: transparent !important;

  color: #5e7889 !important;

  border: none !important;

  font-size: 14px !important;

  font-weight: 600;

  cursor: pointer;
}


.flash-home-button:hover {
  background: transparent !important;

  color: #168dc4 !important;
}


/* =====================================================
   フラッシュ暗算画面
   タブレット・スマートフォン
===================================================== */

@media (max-width: 900px) {

  .flash-menu-cards {
    grid-template-columns: 1fr;

    gap: 18px;
  }


  .flash-menu-card {
    min-height: 285px;
  }

}


/* =====================================================
   フラッシュ暗算画面
   小型スマートフォン
===================================================== */

@media (max-width: 600px) {

  #flashSelect {
    padding: 38px 15px 35px;
  }


  .flash-select-inner {
    width: 94%;
  }


  .flash-select-header {
    margin-bottom: 30px;
  }


  .flash-select-icon {
    width: 60px;
    height: 60px;

    margin-bottom: 14px;

    border-radius: 17px;

    font-size: 30px;
  }


  .flash-select-header h1 {
    font-size: 30px;
  }


  .flash-select-header p {
    font-size: 13px;
  }


  .flash-menu-card {
    min-height: 270px;

    padding: 27px 23px;
  }


  .flash-menu-icon {
    width: 68px;
    height: 68px;

    margin-bottom: 16px;

    border-radius: 18px;

    font-size: 34px;
  }


  .flash-menu-card h2 {
    font-size: 22px;
  }


  .flash-menu-card p {
    margin-bottom: 22px;

    font-size: 13px;
  }

}